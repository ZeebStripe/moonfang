{
  "name": "moonfang",
  "productName": "Moonfang 3D Textures",
  "version": "0.1.0-beta",
  "private": true,
  "description": "Open source 3D texture painting tool (PBR layer painting, mesh-map baking, smart materials)",
  "author": "ZeebStripe",
  "homepage": "https://github.com/ZeebStripe/moonfang",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "app": "vite build && electron .",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "electron": "44.4.5",
    "electron-builder": "26.16.1",
    "fflate": "^0.8.3",
    "three": "^0.186.1",
    "three-mesh-bvh": "0.9.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "electron@44.4.5": true
  },
  "build": {
    "appId": "io.uwustud.moonfang",
    "productName": "Moonfang 3D Textures",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "icon.png",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE.moonfang.txt"
      }
    ],
    "artifactName": "Moonfang-3D-Textures-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Moonfang-3D-Textures-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Moonfang-3D-Textures-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "icon.png",
      "category": "Graphics",
      "artifactName": "Moonfang-3D-Textures-${version}-linux-${arch}.${ext}"
    }
  }
}
